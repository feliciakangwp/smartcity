# Optional. Leave empty to run in Demo Mode (seed data + browser storage).
# Use the project's public anon key only — never the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional login page. Generate with: SITE_PASSWORD='your password' node scripts/hash-password.mjs >> .env.local
# On GitHub Pages these are made from the SITE_PASSWORD repository secret instead.
VITE_ACCESS_SALT=
VITE_ACCESS_HASH=
VITE_ACCESS_ITERATIONS=
